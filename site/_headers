/*
  Strict-Transport-Security: max-age=15552000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; form-action 'none'

/index.html
  Cache-Control: no-cache

/ko/
  Cache-Control: no-cache
/ko/index.html
  Cache-Control: no-cache
/ko/whitepaper.html
  Cache-Control: no-cache
/en/
  Cache-Control: no-cache
/en/index.html
  Cache-Control: no-cache
/en/whitepaper.html
  Cache-Control: no-cache
/ko/agents
  Cache-Control: no-cache
/ko/agents.html
  Cache-Control: no-cache
/en/agents
  Cache-Control: no-cache
/en/agents.html
  Cache-Control: no-cache

/llms.txt
  Cache-Control: public, max-age=3600
/.well-known/*
  Cache-Control: public, max-age=3600

/assets/*
  Cache-Control: public, max-age=604800, immutable
